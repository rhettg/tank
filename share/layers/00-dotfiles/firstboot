#!/bin/bash
# Clone and install user dotfiles on first boot.
set -euo pipefail

SECRETS_FILE="/run/tank/dotfiles.env"

if [ ! -f "$SECRETS_FILE" ]; then
    echo "Error: $SECRETS_FILE not found - preboot hook may have failed" >&2
    exit 1
fi

source "$SECRETS_FILE"

DOTFILES_REPO="${DOTFILES_REPO:-${DOTFILES_REPO_URL:-}}"
DOTFILES_INSTALL_DIR="${DOTFILES_INSTALL_DIR:-.dotfiles}"

if [ -z "$DOTFILES_REPO" ]; then
    echo "Error: DOTFILES_REPO not set in $SECRETS_FILE" >&2
    exit 1
fi

# Find the primary human user.
DEFAULT_USER="$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1; exit}' /etc/passwd)"
if [ -z "$DEFAULT_USER" ]; then
    echo "No human user found, skipping dotfiles"
    exit 0
fi

USER_HOME="$(eval echo "~$DEFAULT_USER")"
DOTFILES_DIR="$USER_HOME/$DOTFILES_INSTALL_DIR"

if [ -d "$DOTFILES_DIR/.git" ]; then
    echo "Dotfiles already present, skipping"
    exit 0
fi

if ! command -v git >/dev/null 2>&1; then
    echo "Error: git is not installed" >&2
    exit 1
fi

echo "Cloning dotfiles from $DOTFILES_REPO into $DOTFILES_DIR..."
su - "$DEFAULT_USER" -c "git clone --recursive '$DOTFILES_REPO' '$DOTFILES_DIR'"

if [ -n "${DOTFILES_INSTALL_CMD:-}" ]; then
    echo "Running custom install command: $DOTFILES_INSTALL_CMD"
    su - "$DEFAULT_USER" -c "cd '$DOTFILES_DIR' && $DOTFILES_INSTALL_CMD"
    echo "Dotfiles setup complete!"
    exit 0
fi

for installer in \
    install.sh \
    install \
    bootstrap.sh \
    bootstrap \
    script/bootstrap \
    setup.sh \
    setup \
    script/setup
do
    if [ -f "$DOTFILES_DIR/$installer" ]; then
        echo "Running dotfiles installer: $installer"
        su - "$DEFAULT_USER" -c "cd '$DOTFILES_DIR' && chmod +x '$installer' && './$installer'"
        echo "Dotfiles setup complete!"
        exit 0
    fi
done

echo "No Codespaces-compatible dotfiles installer found in $DOTFILES_DIR" >&2
exit 1
